---
import ThemeToggle from "./ThemeToggle.astro";
import { siteConfig } from "../data/site";

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

const normalizePath = (path: string) => {
  const normalized = path.replace(/\/+$/, "");
  return normalized.length > 0 ? normalized : "/";
};

const isActive = (href: string) => {
  if (/^https?:/i.test(href) || href.startsWith("mailto:")) {
    return false;
  }

  const target = normalizePath(href);
  if (target === "/") {
    return currentPath === "/";
  }

  return currentPath === target || currentPath.startsWith(`${target}/`);
};
---

<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-slate-50/90 backdrop-blur dark:border-slate-800 dark:bg-slate-950/80">
  <div class="container-page flex min-h-16 items-center justify-between gap-4 py-2">
    <a href="/" class="font-serif text-lg font-semibold tracking-tight text-slate-900 dark:text-slate-100">
      {siteConfig.name}
    </a>

    <button
      class="inline-flex items-center justify-center rounded-lg border border-slate-300 p-2 text-slate-700 hover:border-accent-400 hover:text-accent-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 focus-visible:ring-offset-2 md:hidden dark:border-slate-700 dark:text-slate-300 dark:hover:border-accent-400 dark:hover:text-accent-200"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-mobile-nav-button
    >
      <span class="sr-only">Toggle menu</span>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary navigation">
      {
        siteConfig.navLinks.map((item) => (
          <a
            href={item.href}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noreferrer" : undefined}
            class:list={[
              "rounded-full px-4 py-2 text-sm font-medium transition",
              isActive(item.href)
                ? "bg-accent-100 text-accent-800 dark:bg-accent-900/40 dark:text-accent-200"
                : "text-slate-600 hover:text-accent-700 dark:text-slate-300 dark:hover:text-accent-200"
            ]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <ThemeToggle className="ml-1" />
    </nav>
  </div>

  <nav id="mobile-nav" class="container-page hidden pb-4 md:hidden" aria-label="Mobile navigation" data-mobile-nav>
    <div class="surface-card p-3">
      <div class="flex flex-col gap-1">
        {
          siteConfig.navLinks.map((item) => (
            <a
              href={item.href}
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noreferrer" : undefined}
              class:list={[
                "rounded-lg px-3 py-2 text-sm font-medium",
                isActive(item.href)
                  ? "bg-accent-100 text-accent-800 dark:bg-accent-900/40 dark:text-accent-200"
                  : "text-slate-600 hover:bg-slate-100 hover:text-accent-700 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-accent-200"
              ]}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </div>
      <div class="mt-3 border-t border-slate-200 pt-3 dark:border-slate-800">
        <ThemeToggle />
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  const navButton = document.querySelector("[data-mobile-nav-button]");
  const mobileNav = document.querySelector("[data-mobile-nav]");

  if (navButton && mobileNav && navButton.dataset.boundMobileNav !== "true") {
    navButton.dataset.boundMobileNav = "true";

    const closeMenu = () => {
      navButton.setAttribute("aria-expanded", "false");
      mobileNav.classList.add("hidden");
    };

    navButton.addEventListener("click", () => {
      const expanded = navButton.getAttribute("aria-expanded") === "true";
      navButton.setAttribute("aria-expanded", String(!expanded));
      mobileNav.classList.toggle("hidden", expanded);
    });

    mobileNav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth >= 768) {
        closeMenu();
      }
    });
  }
</script>