---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;

const linkEntries = [
  ["paper", "Paper"],
  ["code", "Code"],
  ["dataset", "Dataset"],
  ["project", "Project"],
  ["model", "Model"]
] as const;
---

<article
  class:list={[
    "surface-card flex h-full flex-col p-6 transition duration-300 motion-safe:hover:-translate-y-1 motion-safe:hover:shadow-soft",
    project.data.featured && "border-accent-300/80 dark:border-accent-700"
  ]}
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-serif text-xl font-semibold leading-snug text-slate-900 dark:text-slate-100">{project.data.title}</h3>
    {project.data.featured && <span class="pill pill-accent">Featured</span>}
  </div>

  <p class="mt-3 text-sm leading-7 text-slate-600 dark:text-slate-300">{project.data.summary}</p>

  <dl class="mt-4 grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
    <div>
      <dt class="font-medium text-slate-500 dark:text-slate-400">Period</dt>
      <dd class="mt-1 text-slate-700 dark:text-slate-200">{project.data.period}</dd>
    </div>
    <div>
      <dt class="font-medium text-slate-500 dark:text-slate-400">Role</dt>
      <dd class="mt-1 text-slate-700 dark:text-slate-200">{project.data.role}</dd>
    </div>
  </dl>

  <div class="mt-4 flex flex-wrap gap-2">
    {project.data.tags.map((tag) => <span class="pill">{tag}</span>)}
  </div>

  <div class="mt-5 flex flex-wrap gap-4 text-sm">
    {
      linkEntries.map(([key, label]) => {
        const href = project.data.links[key];
        if (!href) {
          return null;
        }

        return (
          <a class="link-inline" href={href} target="_blank" rel="noreferrer">
            {label}
          </a>
        );
      })
    }
  </div>

  {
    project.data.isPlaceholder && (
      <p class="mt-4 rounded-lg border border-dashed border-slate-300 bg-slate-100/80 px-3 py-2 text-xs text-slate-600 dark:border-slate-700 dark:bg-slate-800/70 dark:text-slate-300">
        Placeholder entry. Replace with concrete project details.
      </p>
    )
  }
</article>