---
import type { CollectionEntry } from "astro:content";

interface Props {
  publication: CollectionEntry<"publications">;
}

const { publication } = Astro.props;

const linkEntries = [
  ["paper", "Paper"],
  ["code", "Code"],
  ["dataset", "Dataset"],
  ["project", "Project"],
  ["model", "Model"]
] as const;
---

<article
  class:list={[
    "surface-card p-6",
    publication.data.featured && "border-accent-300/80 dark:border-accent-700"
  ]}
>
  <div class="flex flex-wrap items-center gap-3">
    <span class="pill">{publication.data.year}</span>
    <span class="pill">{publication.data.type}</span>
    <span class="pill pill-accent">{publication.data.status}</span>
    {publication.data.featured && <span class="pill pill-accent">Representative</span>}
  </div>

  <h3 class="mt-4 font-serif text-xl font-semibold leading-snug text-slate-900 dark:text-slate-100">
    {publication.data.title}
  </h3>
  <p class="mt-3 text-sm text-slate-700 dark:text-slate-200">
    {publication.data.authors.join(", ")}
  </p>
  <p class="mt-1 text-sm font-medium text-slate-600 dark:text-slate-300">{publication.data.venue}</p>

  {publication.data.summary && (
    <p class="mt-3 text-sm leading-7 text-slate-600 dark:text-slate-300">{publication.data.summary}</p>
  )}

  <div class="mt-4 flex flex-wrap gap-4 text-sm">
    {
      linkEntries.map(([key, label]) => {
        const href = publication.data.links[key];
        if (!href) {
          return null;
        }

        return (
          <a class="link-inline" href={href} target="_blank" rel="noreferrer">
            {label}
          </a>
        );
      })
    }
  </div>
</article>