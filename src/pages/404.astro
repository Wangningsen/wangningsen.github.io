---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found" description="The requested page could not be found.">
  <section class="mx-auto mt-16 max-w-xl text-center">
    <p class="text-sm uppercase tracking-[0.2em] text-accent-700 dark:text-accent-300">404</p>
    <h1 class="mt-4 font-serif text-4xl font-semibold text-slate-900 dark:text-slate-100">Page Not Found</h1>
    <p class="mt-4 text-sm leading-7 text-slate-600 dark:text-slate-300">
      The page you requested does not exist or may have moved.
    </p>
    <a href="/" class="mt-8 inline-flex rounded-full bg-accent-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-accent-600">
      Return Home
    </a>
  </section>
</BaseLayout>