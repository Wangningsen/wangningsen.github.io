---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { siteConfig } from "../data/site";
---

<BaseLayout
  title="About"
  description="About Ningsen Wang: background, research interests, and ongoing academic path in medical AI."
>
  <SectionHeader
    title="About"
    description="Long-form context on my background, research direction, and current trajectory."
  />

  <section class="section-space mt-8">
    <div class="surface-card p-6 sm:p-8">
      <div class="space-y-4 text-sm leading-8 text-slate-600 dark:text-slate-300">
        {siteConfig.aboutNarrative.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="section-space">
    <h2 class="section-title">Research Interests</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {
        siteConfig.researchInterests.map((item) => (
          <article class="surface-card p-5">
            <h3 class="font-serif text-lg font-semibold text-slate-900 dark:text-slate-100">{item.title}</h3>
            <p class="mt-3 text-sm leading-7 text-slate-600 dark:text-slate-300">{item.description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section-space">
    <h2 class="section-title">Timeline</h2>
    <ol class="mt-6 space-y-4">
      {
        siteConfig.timeline.map((entry) => (
          <li class="surface-card p-5">
            <p class="text-xs uppercase tracking-widest text-accent-700 dark:text-accent-300">{entry.dateLabel}</p>
            {
              entry.href ? (
                <a href={entry.href} target="_blank" rel="noreferrer" class="mt-2 block text-sm font-medium link-inline">
                  {entry.detail}
                </a>
              ) : (
                <p class="mt-2 text-sm text-slate-700 dark:text-slate-200">{entry.detail}</p>
              )
            }
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section-space">
    <h2 class="section-title">Collaborations and Community</h2>
    <div class="surface-card mt-6 p-6">
      <p class="text-sm leading-7 text-slate-600 dark:text-slate-300">{siteConfig.collaborationNote}</p>
      <p class="mt-4 text-xs text-slate-500 dark:text-slate-400">
        TODO: Add sections for collaborations, open-source contributions, mentoring, and selected extracurricular interests.
      </p>
    </div>
  </section>
</BaseLayout>