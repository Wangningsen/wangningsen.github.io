---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ProjectCard from "../components/ProjectCard.astro";
import PublicationCard from "../components/PublicationCard.astro";
import NewsItem from "../components/NewsItem.astro";
import BlogPreviewCard from "../components/BlogPreviewCard.astro";
import { siteConfig } from "../data/site";

const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.sortDate.getTime() - a.data.sortDate.getTime()
);
const publications = (await getCollection("publications")).sort((a, b) => {
  if (a.data.year !== b.data.year) {
    return b.data.year - a.data.year;
  }

  return Number(b.data.featured) - Number(a.data.featured);
});
const newsItems = (await getCollection("news")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const selectedProjects = projects.slice(0, 6);
const selectedPublications =
  publications.filter((item) => item.data.featured).length > 0
    ? publications.filter((item) => item.data.featured)
    : publications.slice(0, 3);
const latestNews = newsItems.slice(0, 4);
const latestPosts = posts.slice(0, 3);
---

<BaseLayout>
  <section class="grid gap-8 lg:grid-cols-[1.45fr_0.55fr] lg:items-start">
    <div class="hero-panel">
      <h1 class="font-serif text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl dark:text-slate-100">
        {siteConfig.name}
        {
          siteConfig.chineseName && (
            <span class="mt-2 block text-2xl font-medium text-slate-500 dark:text-slate-400">{siteConfig.chineseName}</span>
          )
        }
      </h1>

      <p class="mt-5 max-w-reading text-base leading-8 text-slate-600 dark:text-slate-300">{siteConfig.shortBio}</p>

      <div class="mt-6 flex flex-wrap gap-2">
        {siteConfig.affiliation.map((item) => <span class="pill">{item}</span>)}
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        {
          siteConfig.primaryCtas.map((cta) => (
            <a
              href={cta.href}
              target={cta.external ? "_blank" : undefined}
              rel={cta.external ? "noreferrer" : undefined}
              class="inline-flex items-center rounded-full border border-slate-300 px-5 py-2.5 text-sm font-medium text-slate-700 transition hover:border-accent-400 hover:text-accent-700 dark:border-slate-700 dark:text-slate-200 dark:hover:border-accent-500 dark:hover:text-accent-200"
            >
              {cta.label}
            </a>
          ))
        }
      </div>
    </div>

    <div class="hero-panel p-5 sm:p-6">
      <div class="mx-auto w-full max-w-[320px] overflow-hidden rounded-xl border border-slate-200 bg-slate-100 dark:border-slate-800 dark:bg-slate-900">
        <div class="aspect-[3/4]">
          <img
            src={siteConfig.avatar}
            alt={`Portrait of ${siteConfig.name}`}
            class="h-full w-full object-cover object-center"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section-space">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeader title="Selected Projects" description="Representative research and engineering work." />
      <a class="link-inline text-sm font-medium" href="/projects">View all projects</a>
    </div>
    <div class="grid gap-5 lg:grid-cols-2">
      {selectedProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="section-space">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeader
        title="Selected Publications"
        description="Highlighted papers with links to paper, project resources, and code when available."
      />
      <a class="link-inline text-sm font-medium" href="/publications">View full list</a>
    </div>
    <div class="space-y-5">
      {selectedPublications.map((publication) => <PublicationCard publication={publication} />)}
    </div>
  </section>

  <section class="section-space grid gap-8 lg:grid-cols-2">
    <div>
      <SectionHeader
        title="Latest News"
        description="Recent milestones from papers, preprints, and research activity."
      />
      <ul class="space-y-4">
        {latestNews.map((item) => <NewsItem item={item} />)}
      </ul>
    </div>

    <div>
      <div class="flex flex-wrap items-end justify-between gap-4">
        <SectionHeader
          title="From the Blog"
          description="Short notes, workflows, and technical reflections in Markdown/MDX."
        />
        <a class="link-inline text-sm font-medium" href="/blog">View all posts</a>
      </div>
      <div class="space-y-4">
        {
          latestPosts.length > 0 ? (
            latestPosts.map((post) => <BlogPreviewCard post={post} />)
          ) : (
            <p class="surface-card p-6 text-sm text-slate-600 dark:text-slate-300">No posts yet.</p>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
