---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import BlogPreviewCard from "../../components/BlogPreviewCard.astro";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout
  title="Blog"
  description="Research notes, engineering logs, and writing by Ningsen Wang in Markdown/MDX."
>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <SectionHeader
      title="Blog"
      description="Posts are maintained in Markdown/MDX via Astro content collections."
    />
    <a class="link-inline text-sm font-medium" href="/rss.xml">Subscribe via RSS</a>
  </div>

  <section class="section-space mt-8">
    {
      posts.length > 0 ? (
        <div class="grid gap-5 md:grid-cols-2">
          {posts.map((post) => <BlogPreviewCard post={post} />)}
        </div>
      ) : (
        <p class="surface-card p-6 text-sm text-slate-600 dark:text-slate-300">No posts yet. Add one in `src/content/blog`.</p>
      )
    }
  </section>
</BaseLayout>